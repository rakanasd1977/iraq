# ===== سوق الرافدين — nginx للإنتاج (HTTPS + عكس وكيل) =====
# ضعه في /etc/nginx/sites-available/rafidain واربطه: ln -s ... sites-enabled
# يُضمّن ملفات المشترك deploy/nginx.headers.conf و nginx.static.conf و nginx.api.conf
#   (انقلها إلى /etc/nginx/rafidain/ أو عدّل المسارات في includes).
# المسارات تفترض أن بناءات الواجهات في /var/www/rafidain/<app>:
#   cd <app> && npm run build && rsync -a dist/ /var/www/rafidain/<app>/
# CORS ليس ضرورياً لأن كل واجهة تحمل /api على نفس مجالها (المسار نسبي).
# كل نقاط الدفعة الثالثة (financial-report و dashboard/export وفلاتر activity)
#   تقع تحت /api/ فتمر عبر الوكيل تلقائياً دون تعديل.

# تحويل http -> https
server {
    listen 80;
    server_name rafidain.example www.rafidain.example agent.rafidain.example admin.rafidain.example provider.rafidain.example;
    return 301 https://$host$request_uri;
}

# ---------- تطبيق الزبون ----------
server {
    listen 443 ssl http2;
    server_name rafidain.example www.rafidain.example;
    root /var/www/rafidain/customer-mobile;
    index index.html;

    include /etc/nginx/rafidain/headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    ssl_certificate     /etc/letsencrypt/live/rafidain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rafidain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/rafidain/static.conf;
    include /etc/nginx/rafidain/api.conf;
}

# ---------- لوحة الوكيل ----------
server {
    listen 443 ssl http2;
    server_name agent.rafidain.example;
    root /var/www/rafidain/agent-panel;
    index index.html;

    include /etc/nginx/rafidain/headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    ssl_certificate     /etc/letsencrypt/live/rafidain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rafidain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/rafidain/static.conf;
    include /etc/nginx/rafidain/api.conf;
}

# ---------- لوحة المسؤول ----------
server {
    listen 443 ssl http2;
    server_name admin.rafidain.example;
    root /var/www/rafidain/admin-panel;
    index index.html;

    include /etc/nginx/rafidain/headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    ssl_certificate     /etc/letsencrypt/live/rafidain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rafidain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/rafidain/static.conf;
    include /etc/nginx/rafidain/api.conf;
}

# ---------- لوحة المزود ----------
server {
    listen 443 ssl http2;
    server_name provider.rafidain.example;
    root /var/www/rafidain/provider-panel;
    index index.html;

    include /etc/nginx/rafidain/headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    ssl_certificate     /etc/letsencrypt/live/rafidain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rafidain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/rafidain/static.conf;
    include /etc/nginx/rafidain/api.conf;
}
